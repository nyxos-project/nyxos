# The Hyprland session the Nyx shell (bar, dock, panels, Glimpse) runs in. Hyprland
# itself comes from the NixOS module (programs.hyprland).
{
  lib,
  osConfig,
  theme,
  ...
}:
let
  c = theme.colors;
in
{
  services.hyprpolkitagent.enable = true;

  xdg.configFile."hypr/hyprland.lua".text = ''
    -- Generated by NyxOS (modules/home/hyprland.nix).

    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

    hl.env("XCURSOR_SIZE", "24")

    hl.config({
      general = {
        gaps_in = 4,
        gaps_out = 8,
        border_size = 2,
        col = {
          active_border = "rgb(${c.accent})",
          inactive_border = "rgb(${c.border})",
        },
        layout = "dwindle",
      },

      decoration = {
        rounding = ${toString theme.radius.card},
        shadow = { enabled = false },
        blur = { enabled = false },
      },

      input = {
        kb_layout = "${osConfig.services.xserver.xkb.layout}",
        follow_mouse = 1,
        touchpad = { natural_scroll = true },
      },

      misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        force_default_wallpaper = 0,
        background_color = "rgb(${c.bg})",
        -- If the lock screen stops, the session stays locked and a new one can take over.
        allow_session_lock_restore = true,
      },

      ecosystem = {
        no_update_news = true,
        no_donation_nag = true,
      },
    })

    local function launch(command)
      return hl.dsp.exec_cmd("uwsm app -- " .. command)
    end

    hl.bind("SUPER + RETURN", launch("foot"))
    hl.bind("SUPER + Q", hl.dsp.window.close())
    hl.bind("SUPER + T", hl.dsp.window.float({ action = "toggle" }))
    hl.bind("SUPER + F", hl.dsp.window.fullscreen({ mode = "fullscreen" }))
    hl.bind("SUPER + SHIFT + E", hl.dsp.exec_cmd("uwsm stop"))
    hl.bind("SUPER + CTRL + L", hl.dsp.exec_cmd("loginctl lock-session"), { description = "Lock" })

    hl.bind("SUPER + LEFT", hl.dsp.focus({ direction = "l" }))
    hl.bind("SUPER + RIGHT", hl.dsp.focus({ direction = "r" }))
    hl.bind("SUPER + UP", hl.dsp.focus({ direction = "u" }))
    hl.bind("SUPER + DOWN", hl.dsp.focus({ direction = "d" }))

    for workspace = 1, 10 do
      local key = "code:" .. tostring(workspace + 9)
      local name = tostring(workspace)
      hl.bind("SUPER + " .. key, hl.dsp.focus({ workspace = name }), { description = "Switch to workspace " .. name })
      hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.move({ workspace = name }), { description = "Move window to workspace " .. name })
      hl.bind("SUPER + SHIFT + ALT + " .. key, hl.dsp.window.move({ workspace = name, follow = false }), { description = "Move window silently to workspace " .. name })
    end

    -- Switcher takes Super+Tab when it runs (it replaces these by their descriptions);
    -- Super+Ctrl+arrows and Super+Ctrl+Tab stay.
    hl.bind("SUPER + TAB", hl.dsp.focus({ workspace = "m+1" }), { description = "Next workspace" })
    hl.bind("SUPER + SHIFT + TAB", hl.dsp.focus({ workspace = "m-1" }), { description = "Previous workspace" })
    hl.bind("SUPER + CTRL + RIGHT", hl.dsp.focus({ workspace = "m+1" }), { description = "Next workspace" })
    hl.bind("SUPER + CTRL + LEFT", hl.dsp.focus({ workspace = "m-1" }), { description = "Previous workspace" })
    hl.bind("SUPER + CTRL + TAB", hl.dsp.focus({ workspace = "previous_per_monitor" }), { description = "Former workspace" })
    hl.bind("SUPER + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
    hl.bind("SUPER + mouse_up", hl.dsp.focus({ workspace = "e-1" }))

    hl.bind("SUPER + S", hl.dsp.workspace.toggle_special("scratchpad"), { description = "Toggle scratchpad" })
    hl.bind("SUPER + ALT + S", hl.dsp.window.move({ workspace = "special:scratchpad", follow = false }), { description = "Move window to scratchpad" })

    hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })
    hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })
  ''
  + lib.optionalString osConfig.nyx.glimpse.enable ''

    hl.bind("SUPER + SPACE", launch("nyx-glimpse --toggle"), { description = "Glimpse" })
  ''
  # Hold Alt+Space to talk to the Assistant (the repeating bind is the hold signal);
  # Super+Shift+Escape stops everything it is doing.
  + lib.optionalString osConfig.nyx.assistant.enable ''

    hl.bind("ALT + SPACE", hl.dsp.exec_cmd("nyx-assistant ptt-start"), { repeating = true, description = "Assistant PTT" })
    hl.bind("SUPER + SHIFT + Escape", hl.dsp.exec_cmd("nyx-assistant cancel"), { description = "Assistant stop" })
    hl.window_rule({
      name = "nyx-assistant-canvas",
      match = { class = "^io\\.github\\.design_nexus\\.nyx\\.assistant\\.visual$", initial_title = "^Canvas$" },
      float = true,
      center = true,
      size = { 820, 620 },
      no_initial_focus = true,
    })
  ''
  # Switcher's shortcuts, which it writes from its settings.
  + lib.optionalString osConfig.nyx.switcher.enable ''

    local nyx_switcher = io.open((os.getenv("HOME") or "") .. "/.config/hypr/nyx-switcher.lua")
    if nyx_switcher then
      nyx_switcher:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/nyx-switcher.lua")
    end
  ''
  # The user's Nyx theme (written by nyx-themed), then the values set in Nyx Settings,
  # last so they win; Settings looks for its require line.
  + lib.optionalString osConfig.nyx.themes.enable ''

    local nyx_theme = io.open((os.getenv("HOME") or "") .. "/.config/hypr/nyx-theme.lua")
    if nyx_theme then
      nyx_theme:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/nyx-theme.lua")
    end
  ''
  # Values set in Nyx Settings, last so they win; Settings looks for this require line.
  + lib.optionalString osConfig.nyx.settings.enable ''

    local nyx_config = (os.getenv("HOME") or "") .. "/.config"
    local nyx_settings = io.open(nyx_config .. "/hypr/settings.lua")
    if nyx_settings then
      nyx_settings:close()
      package.path = nyx_config .. "/?.lua;" .. package.path
      require("hypr.settings") -- Settings app (managed values, loaded last)
    end
  '';
}
