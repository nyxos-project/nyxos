# Temporary minimal Hyprland session until Nyx Bar, Dock and the rest of the shell
# are packaged. Hyprland itself comes from the NixOS module (programs.hyprland).
{
  lib,
  osConfig,
  theme,
  ...
}:
let
  c = theme.colors;
in
{
  services.hyprpolkitagent.enable = true;

  xdg.configFile."hypr/hyprland.lua".text = ''
    -- Generated by NyxOS (modules/home/hyprland.nix).

    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

    hl.env("XCURSOR_SIZE", "24")

    hl.config({
      general = {
        gaps_in = 4,
        gaps_out = 8,
        border_size = 2,
        col = {
          active_border = "rgb(${c.accent})",
          inactive_border = "rgb(${c.border})",
        },
        layout = "dwindle",
      },

      decoration = {
        rounding = ${toString theme.radius.card},
        shadow = { enabled = false },
        blur = { enabled = false },
      },

      input = {
        kb_layout = "us",
        follow_mouse = 1,
        touchpad = { natural_scroll = true },
      },

      misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        force_default_wallpaper = 0,
        background_color = "rgb(${c.bg})",
      },

      ecosystem = {
        no_update_news = true,
        no_donation_nag = true,
      },
    })

    local function launch(command)
      return hl.dsp.exec_cmd("uwsm app -- " .. command)
    end

    hl.bind("SUPER + RETURN", launch("foot"))
    hl.bind("SUPER + Q", hl.dsp.window.close())
    hl.bind("SUPER + T", hl.dsp.window.float({ action = "toggle" }))
    hl.bind("SUPER + F", hl.dsp.window.fullscreen({ mode = "fullscreen" }))
    hl.bind("SUPER + SHIFT + E", hl.dsp.exec_cmd("uwsm stop"))

    hl.bind("SUPER + LEFT", hl.dsp.focus({ direction = "l" }))
    hl.bind("SUPER + RIGHT", hl.dsp.focus({ direction = "r" }))
    hl.bind("SUPER + UP", hl.dsp.focus({ direction = "u" }))
    hl.bind("SUPER + DOWN", hl.dsp.focus({ direction = "d" }))

    for workspace = 1, 10 do
      local key = "code:" .. tostring(workspace + 9)
      hl.bind("SUPER + " .. key, hl.dsp.focus({ workspace = tostring(workspace) }))
      hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.move({ workspace = tostring(workspace) }))
    end

    hl.bind("SUPER + TAB", hl.dsp.focus({ workspace = "e+1" }))
    hl.bind("SUPER + SHIFT + TAB", hl.dsp.focus({ workspace = "e-1" }))
    hl.bind("SUPER + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
    hl.bind("SUPER + mouse_up", hl.dsp.focus({ workspace = "e-1" }))

    hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })
    hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })
  ''
  # Hold Alt+Space to talk to the Assistant (the repeating bind is the hold signal);
  # Super+Shift+Escape stops everything it is doing.
  + lib.optionalString osConfig.nyx.assistant.enable ''

    hl.bind("ALT + SPACE", hl.dsp.exec_cmd("nyx-assistant ptt-start"), { repeating = true, description = "Assistant PTT" })
    hl.bind("SUPER + SHIFT + Escape", hl.dsp.exec_cmd("nyx-assistant cancel"), { description = "Assistant stop" })
    hl.window_rule({
      name = "nyx-assistant-canvas",
      match = { class = "^io\\.github\\.design_nexus\\.nyx\\.assistant\\.visual$", initial_title = "^Canvas$" },
      float = true,
      center = true,
      size = { 820, 620 },
      no_initial_focus = true,
    })
  '';
}
