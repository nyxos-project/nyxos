# The Hyprland session the Nyx shell (bar, dock, panels, Glimpse) runs in. Hyprland
# itself comes from the NixOS module (programs.hyprland). Its options, animations,
# gestures and persistent workspaces are NyxOS's defaults in defaults/hyprland.toml (the
# reference desktop, docs/audit/desktop-defaults.md); the key bindings are below. A user's
# own values (Nyx Settings' settings.lua, loaded last) win over both.
{
  lib,
  pkgs,
  osConfig,
  inputs,
  theme,
  ...
}:
let
  nyxPkgs = inputs.nyx-packages.packages.${pkgs.stdenv.hostPlatform.system};
  c = theme.colors;
  defaults = builtins.fromTOML (builtins.readFile ../../defaults/hyprland.toml);
  lua = lib.generators.toLua { };
  enabled = app: osConfig.nyx.${app}.enable or false;

  # hyprland-nyx's option; set only where Hyprland has it (below).
  swipeWrap = defaults.options.gestures.workspace_swipe_wrap or false;
  options =
    lib.recursiveUpdate
      (
        defaults.options
        // {
          gestures = removeAttrs (defaults.options.gestures or { }) [ "workspace_swipe_wrap" ];
        }
      )
      {
        general.col = {
          active_border = "rgb(${c.accent})";
          inactive_border = "rgb(${c.border})";
        };
        group.col = {
          border_active = "rgb(${c.accent})";
          border_inactive = "rgb(${c.border})";
        };
        group.groupbar = {
          text_color = "rgb(${c.text})";
          text_color_inactive = "rgb(${c.dimText})";
        };
        input.kb_layout = osConfig.services.xserver.xkb.layout;
        misc = {
          disable_hyprland_logo = true;
          disable_splash_rendering = true;
          force_default_wallpaper = 0;
          background_color = "rgb(${c.bg})";
          # If the lock screen stops, the session stays locked and a new one can take over.
          allow_session_lock_restore = true;
        };
        ecosystem = {
          no_update_news = true;
          no_donation_nag = true;
          # Screen capture only for the programs below (screenCapture).
          enforce_permissions = true;
        };
      };

  # Who may read the screen directly: the portal (apps that share the screen ask
  # through it), the grim and wf-recorder that Capture, Chat and the Assistant run, and
  # the Switcher and Dock, which show window thumbnails. Everything else is refused
  # without asking. Rules match the program's store path, so nixpkgs' grim run by
  # another program is refused. Hyprland reads these rules only when it starts; a
  # session that reloads into them asks about every capture until the next sign-in.
  screenCapture = [
    osConfig.programs.hyprland.portalPackage
    nyxPkgs.nyx-screen-grim
    nyxPkgs.nyx-screen-wf-recorder
  ]
  ++ lib.optional (enabled "switcher") nyxPkgs.nyx-switcher
  ++ lib.optional (enabled "dock") nyxPkgs.nyx-dock
  ++ osConfig.nyxos.desktop.screenCapture or [ ];
  permissions = lib.concatMapStringsSep "\n" (
    p: "hl.permission(${lua "${lib.escapeRegex "${p}"}/.*"}, \"screencopy\", \"allow\")"
  ) screenCapture;

  gesture =
    g:
    let
      action =
        if g ? workspace then
          lib.generators.mkLuaInline ''function() hl.dispatch(hl.dsp.focus({ workspace = "${g.workspace}" })) end''
        else if g ? exec then
          lib.generators.mkLuaInline "function() hl.exec_cmd(${lua g.exec}) end"
        else
          g.action;
    in
    "hl.gesture(${
      lua {
        inherit (g) fingers direction;
        inherit action;
      }
    })";
  gestures = builtins.filter (g: !(g ? app) || enabled g.app) (defaults.gestures or [ ]);

  wpctl = "${pkgs.wireplumber}/bin/wpctl";
  brightnessctl = "${pkgs.brightnessctl}/bin/brightnessctl";
  playerctl = "${pkgs.playerctl}/bin/playerctl";
in
{
  xdg.configFile."hypr/hyprland.lua".text = ''
    -- Generated by NyxOS (modules/home/hyprland.nix from defaults/hyprland.toml).

    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

    hl.env("XCURSOR_SIZE", "24")
    hl.env("HYPRCURSOR_SIZE", "24")

    hl.config(${lua options})
    ${permissions}
    hl.permission(".*", "screencopy", "deny")
    if hl.get_config("gestures.workspace_swipe_wrap") ~= nil then
      hl.config({ gestures = { workspace_swipe_wrap = ${lua swipeWrap} } })
    end

    ${lib.concatMapStringsSep "\n" (
      k: "hl.curve(${lua k.name}, { type = \"bezier\", points = ${lua k.points} })"
    ) (defaults.curves or [ ])}
    ${lib.concatMapStringsSep "\n" (a: "hl.animation(${lua a})") (defaults.animations or [ ])}

    for workspace = 1, ${toString (defaults.workspaces.persistent or 0)} do
      hl.workspace_rule({ workspace = tostring(workspace), persistent = true })
    end

    -- A fullscreen app gets a workspace of its own (nyx-hyprland's patch).
    if hl.get_config("misc.fullscreen_own_workspace") ~= nil then
      hl.config({ misc = { fullscreen_own_workspace = true } })
    end

    -- Each workspace's mode from the Control Center's Workspace mode tile and Settings
    -- (nyx-desktop's omarchy::set_workspace): one Hyprland workspace rule per file.
    local nyx_modes = (os.getenv("XDG_STATE_HOME") or ((os.getenv("HOME") or "") .. "/.local/state")) .. "/nyx/workspace-modes/"
    for workspace = 1, 32 do
      local saved = io.open(nyx_modes .. workspace .. ".lua")
      if saved then
        saved:close()
        pcall(dofile, nyx_modes .. workspace .. ".lua")
      end
    end

    ${lib.concatMapStringsSep "\n" gesture gestures}

    local function launch(command)
      return hl.dsp.exec_cmd("uwsm app -- " .. command)
    end

    -- Windows
    hl.bind("SUPER + RETURN", launch("xdg-terminal-exec"), { description = "Terminal" })
    hl.bind("SUPER + W", hl.dsp.window.close(), { description = "Close window" })
    hl.bind("SUPER + Q", hl.dsp.window.close(), { description = "Close window" })
    hl.bind("SUPER + J", hl.dsp.layout("togglesplit"), { description = "Toggle window split" })
    hl.bind("SUPER + P", hl.dsp.window.pseudo(), { description = "Pseudo window" })
    hl.bind("SUPER + T", hl.dsp.window.float({ action = "toggle" }), { description = "Toggle window floating/tiling" })
    hl.bind("SUPER + F", hl.dsp.window.fullscreen({ mode = "fullscreen" }), { description = "Full screen" })
    hl.bind("SUPER + ALT + F", hl.dsp.window.fullscreen({ mode = "maximized" }), { description = "Full width" })
    hl.bind("SUPER + SHIFT + E", hl.dsp.exec_cmd("uwsm stop"), { description = "Sign out" })
    hl.bind("SUPER + CTRL + L", hl.dsp.exec_cmd("loginctl lock-session"), { description = "Lock" })
    hl.bind("SUPER + SHIFT + CTRL + A", launch("nyx agent"), { description = "Coding agent" })
    hl.bind("SUPER + SHIFT + RETURN", hl.dsp.exec_cmd("sh -c 'uwsm app -- gtk-launch \"$(xdg-settings get default-web-browser)\"'"), { description = "Browser" })

    for _, d in ipairs({ { "LEFT", "l", "left" }, { "RIGHT", "r", "right" }, { "UP", "u", "up" }, { "DOWN", "d", "down" } }) do
      hl.bind("SUPER + " .. d[1], hl.dsp.focus({ direction = d[2] }), { description = "Focus on " .. d[3] .. " window" })
      hl.bind("SUPER + SHIFT + " .. d[1], hl.dsp.window.swap({ direction = d[2] }), { description = "Swap window " .. d[3] })
      hl.bind("SUPER + SHIFT + ALT + " .. d[1], hl.dsp.workspace.move({ monitor = d[2] }), { description = "Move workspace to " .. d[3] .. " monitor" })
      hl.bind("SUPER + SHIFT + CTRL + " .. d[1], hl.dsp.window.move({ monitor = d[2] }), { description = "Move window to " .. d[3] .. " monitor" })
      hl.bind("SUPER + ALT + " .. d[1], hl.dsp.window.move({ into_group = d[2] }), { description = "Move window to group " .. d[3] })
    end

    -- The Switcher takes Alt+Tab and Super+Tab when it runs (it replaces these by their
    -- descriptions).
    hl.bind("ALT + TAB", hl.dsp.window.cycle_next(), { description = "Focus on next window" })
    hl.bind("ALT + SHIFT + TAB", hl.dsp.window.cycle_next({ next = false }), { description = "Focus on previous window" })
    hl.bind("CTRL + ALT + TAB", hl.dsp.focus({ monitor = "+1" }), { description = "Focus on next monitor" })
    hl.bind("CTRL + ALT + SHIFT + TAB", hl.dsp.focus({ monitor = "-1" }), { description = "Focus on previous monitor" })

    -- Resize: Super+minus and Super+equals, with Shift for height; Alt a little, Ctrl a lot.
    for _, step in ipairs({ { "", 100 }, { "ALT + ", 25 }, { "CTRL + ", 300 } }) do
      hl.bind("SUPER + " .. step[1] .. "code:20", hl.dsp.window.resize({ x = -step[2], y = 0, relative = true }), { description = "Expand window left" })
      hl.bind("SUPER + " .. step[1] .. "code:21", hl.dsp.window.resize({ x = step[2], y = 0, relative = true }), { description = "Shrink window left" })
      hl.bind("SUPER + SHIFT + " .. step[1] .. "code:20", hl.dsp.window.resize({ x = 0, y = -step[2], relative = true }), { description = "Shrink window up" })
      hl.bind("SUPER + SHIFT + " .. step[1] .. "code:21", hl.dsp.window.resize({ x = 0, y = step[2], relative = true }), { description = "Expand window down" })
    end

    -- Groups
    hl.bind("SUPER + G", hl.dsp.group.toggle(), { description = "Toggle window grouping" })
    hl.bind("SUPER + ALT + G", hl.dsp.window.move({ out_of_group = true }), { description = "Move active window out of group" })
    hl.bind("SUPER + ALT + TAB", hl.dsp.group.next(), { description = "Next window in group" })
    hl.bind("SUPER + ALT + SHIFT + TAB", hl.dsp.group.prev(), { description = "Previous window in group" })
    hl.bind("SUPER + ALT + mouse_down", hl.dsp.group.next(), { description = "Next window in group" })
    hl.bind("SUPER + ALT + mouse_up", hl.dsp.group.prev(), { description = "Previous window in group" })
    for index = 1, 5 do
      hl.bind("SUPER + ALT + code:" .. tostring(index + 9), hl.dsp.group.active({ index = index }), { description = "Switch to group window " .. index })
    end

    -- Workspaces
    for workspace = 1, 10 do
      local key = "code:" .. tostring(workspace + 9)
      local name = tostring(workspace)
      hl.bind("SUPER + " .. key, hl.dsp.focus({ workspace = name }), { description = "Switch to workspace " .. name })
      hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.move({ workspace = name }), { description = "Move window to workspace " .. name })
      hl.bind("SUPER + SHIFT + ALT + " .. key, hl.dsp.window.move({ workspace = name, follow = false }), { description = "Move window silently to workspace " .. name })
    end
    hl.bind("SUPER + TAB", hl.dsp.focus({ workspace = "m+1" }), { description = "Next workspace" })
    hl.bind("SUPER + SHIFT + TAB", hl.dsp.focus({ workspace = "m-1" }), { description = "Previous workspace" })
    hl.bind("SUPER + CTRL + RIGHT", hl.dsp.focus({ workspace = "m+1" }), { description = "Next workspace" })
    hl.bind("SUPER + CTRL + LEFT", hl.dsp.focus({ workspace = "m-1" }), { description = "Previous workspace" })
    hl.bind("SUPER + CTRL + TAB", hl.dsp.focus({ workspace = "previous_per_monitor" }), { description = "Former workspace" })
    hl.bind("SUPER + mouse_down", hl.dsp.focus({ workspace = "m+1" }), { description = "Scroll active workspace forward" })
    hl.bind("SUPER + mouse_up", hl.dsp.focus({ workspace = "m-1" }), { description = "Scroll active workspace backward" })
    hl.bind("SUPER + S", hl.dsp.workspace.toggle_special("scratchpad"), { description = "Toggle scratchpad" })
    hl.bind("SUPER + ALT + S", hl.dsp.window.move({ workspace = "special:scratchpad", follow = false }), { description = "Move window to scratchpad" })

    hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true, description = "Move window" })
    hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true, description = "Resize window" })

    -- Volume, brightness and media keys, also on the lock screen.
    hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("${wpctl} set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true, description = "Volume up" })
    hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("${wpctl} set-volume @DEFAULT_AUDIO_SINK@ 5%-"), { locked = true, repeating = true, description = "Volume down" })
    hl.bind("ALT + XF86AudioRaiseVolume", hl.dsp.exec_cmd("${wpctl} set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+"), { locked = true, repeating = true, description = "Volume up precise" })
    hl.bind("ALT + XF86AudioLowerVolume", hl.dsp.exec_cmd("${wpctl} set-volume @DEFAULT_AUDIO_SINK@ 1%-"), { locked = true, repeating = true, description = "Volume down precise" })
    hl.bind("XF86AudioMute", hl.dsp.exec_cmd("${wpctl} set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true, description = "Mute" })
    hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("${wpctl} set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { locked = true, description = "Mute microphone" })
    hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("${brightnessctl} -e4 -n2 set 5%+"), { locked = true, repeating = true, description = "Brightness up" })
    hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("${brightnessctl} -e4 -n2 set 5%-"), { locked = true, repeating = true, description = "Brightness down" })
    hl.bind("ALT + XF86MonBrightnessUp", hl.dsp.exec_cmd("${brightnessctl} -n2 set 1%+"), { locked = true, repeating = true, description = "Brightness up precise" })
    hl.bind("ALT + XF86MonBrightnessDown", hl.dsp.exec_cmd("${brightnessctl} -n2 set 1%-"), { locked = true, repeating = true, description = "Brightness down precise" })
    hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("${playerctl} play-pause"), { locked = true, description = "Play" })
    hl.bind("XF86AudioPause", hl.dsp.exec_cmd("${playerctl} play-pause"), { locked = true, description = "Pause" })
    hl.bind("XF86AudioNext", hl.dsp.exec_cmd("${playerctl} next"), { locked = true, description = "Next track" })
    hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("${playerctl} previous"), { locked = true, description = "Previous track" })
  ''
  # Each Nyx app's keys, when it's installed.
  + lib.optionalString (enabled "glimpse") ''

    hl.bind("SUPER + SPACE", launch("nyx-glimpse --toggle"), { description = "Glimpse" })
  ''
  + lib.optionalString (enabled "control-center") ''
    hl.bind("SUPER + D", hl.dsp.exec_cmd("nyx-control-center --toggle"), { description = "Control Center" })
  ''
  + lib.optionalString (enabled "notification-center") ''
    hl.bind("SUPER + N", hl.dsp.exec_cmd("nyx-notification-center --toggle"), { description = "Notification Center" })
  ''
  + lib.optionalString (enabled "clipboard") ''
    hl.bind("SUPER + CTRL + V", hl.dsp.exec_cmd("nyx-clipboard --toggle"), { description = "Clipboard" })
  ''
  + lib.optionalString (enabled "capture") ''
    hl.bind("PRINT", hl.dsp.exec_cmd("nyx-capture --capture"), { description = "Screenshot" })
    hl.bind("SUPER + CTRL + ALT + C", hl.dsp.exec_cmd("nyx-capture --capture"), { description = "Screenshot" })
    hl.bind("ALT + PRINT", hl.dsp.exec_cmd("nyx-capture --capture record"), { description = "Screen recording" })
    hl.bind("SUPER + SHIFT + CTRL + C", hl.dsp.exec_cmd("nyx-capture --capture record"), { description = "Screen recording" })
  ''
  + lib.optionalString (enabled "activity") ''
    hl.bind("SUPER + CTRL + Escape", launch("nyx-activity"), { description = "Task Manager" })
  ''
  + lib.optionalString (enabled "settings") ''
    hl.bind("SUPER + ALT + Escape", launch("nyx-settings"), { description = "Settings" })
  ''
  + lib.optionalString (enabled "files") ''
    hl.bind("SUPER + SHIFT + F", launch("nyx-files"), { description = "File manager" })
  ''
  # Hold Alt+Space to talk to the Assistant (the repeating bind is the hold signal);
  # Super+Shift+Escape stops everything it is doing.
  + lib.optionalString (enabled "assistant") ''

    hl.bind("ALT + SPACE", hl.dsp.exec_cmd("nyx-assistant ptt-start"), { repeating = true, description = "Assistant PTT" })
    hl.bind("SUPER + SHIFT + Escape", hl.dsp.exec_cmd("nyx-assistant cancel"), { description = "Assistant stop" })
    hl.window_rule({
      name = "nyx-assistant-canvas",
      match = { class = "^io\\.github\\.design_nexus\\.nyx\\.assistant\\.visual$", initial_title = "^Canvas$" },
      float = true,
      center = true,
      size = { 820, 620 },
      no_initial_focus = true,
    })
  ''
  # Switcher's shortcuts, which it writes from its settings.
  + lib.optionalString (enabled "switcher") ''

    local nyx_switcher = io.open((os.getenv("HOME") or "") .. "/.config/hypr/nyx-switcher.lua")
    if nyx_switcher then
      nyx_switcher:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/nyx-switcher.lua")
    end
  ''
  # Nyx Shell Core: Hyprland's event socket doesn't report monitor mode, scale or
  # position changes, so they're posted as custom>>nyx-monitors (nyx-desktop reads it); then its
  # shortcuts, written by `nyx-shellctl shortcuts --apply` from [shortcuts].
  + lib.optionalString (enabled "shell") ''

    hl.on("monitor.layout_changed", function() hl.dispatch(hl.dsp.event("nyx-monitors")) end)
    local nyx_shell = io.open((os.getenv("HOME") or "") .. "/.config/hypr/nyx-shell.lua")
    if nyx_shell then
      nyx_shell:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/nyx-shell.lua")
    end
  ''
  # Adaptive window controls: NyxOS's decorations (headerbars for apps without
  # controls, floating geometry kept across tiling), then the per-app rules
  # `nyx-shellctl window-controls --apply` writes from [window_controls] in shell.toml,
  # brought up to date at every start (it reloads only when they changed). Before the
  # theme, which colours the headerbars.
  + lib.optionalString (enabled "shell") ''

    hl.plugin.load("${nyxPkgs.nyx-decor}/lib/nyx-decor.so")
    local nyx_window_controls = io.open((os.getenv("HOME") or "") .. "/.config/hypr/nyx-window-controls.lua")
    if nyx_window_controls then
      nyx_window_controls:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/nyx-window-controls.lua")
    end
    hl.on("hyprland.start", function() hl.exec_cmd("nyx-shellctl window-controls --apply") end)
  ''
  # The user's Nyx theme (written by nyx-themed), then the values set in Nyx Settings,
  # last so they win; Settings looks for its require line.
  + lib.optionalString (enabled "themes") ''

    local nyx_theme = io.open((os.getenv("HOME") or "") .. "/.config/hypr/nyx-theme.lua")
    if nyx_theme then
      nyx_theme:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/nyx-theme.lua")
    end
  ''
  # Virtual monitors (a wide screen split in two or three), written by Nyx Settings and
  # `nyx display virtual`. The file checks that this Hyprland has them.
  + ''

    local nyx_virtual = io.open((os.getenv("HOME") or "") .. "/.config/hypr/nyx-virtual-monitors.lua")
    if nyx_virtual then
      nyx_virtual:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/nyx-virtual-monitors.lua")
    end
  ''
  # Activity's startup items (its Startup page writes them; Hyprland's start hook runs them).
  + ''

    local nyx_activity = io.open((os.getenv("HOME") or "") .. "/.config/hypr/activity.lua")
    if nyx_activity then
      nyx_activity:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/activity.lua")
    end
  ''
  # The user's own Hyprland settings, for hand edits; NyxOS never writes this file.
  + ''

    local nyx_user = io.open((os.getenv("HOME") or "") .. "/.config/hypr/user.lua")
    if nyx_user then
      nyx_user:close()
      dofile((os.getenv("HOME") or "") .. "/.config/hypr/user.lua")
    end
  ''
  # Values set in Nyx Settings, last so they win; Settings looks for this require line.
  + lib.optionalString (enabled "settings") ''

    local nyx_config = (os.getenv("HOME") or "") .. "/.config"
    local nyx_settings = io.open(nyx_config .. "/hypr/settings.lua")
    if nyx_settings then
      nyx_settings:close()
      package.path = nyx_config .. "/?.lua;" .. package.path
      require("hypr.settings") -- Settings app (managed values, loaded last)
    end
  '';
}
