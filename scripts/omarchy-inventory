#!/usr/bin/env python3
"""Where the Nyx sources still depend on Omarchy, for stripping Omarchy support.

Scans NyxOS, nyx-packages, nyx-system and every app nyx-packages pins (a checkout in
~/Projects wins over the pinned source) and writes docs/omarchy-removal.md:

- calls: `omarchy-*` commands the code runs, and whether `nyx-platform` has a job for it
- gates: code that behaves differently on Omarchy (`omarchy::here()`, `env.omarchy`,
  `omarchy_available()`, `ThemeMode::Omarchy`, ...)
- paths: Omarchy's files and folders (`~/.config/omarchy`, `/usr/share/omarchy`)

Run it again after each cleanup: `scripts/omarchy-inventory [--projects DIR]`.
"""

import argparse
import json
import re
import subprocess
from collections import defaultdict
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CODE = {".rs", ".qml", ".js", ".sh", ".py", ".nix", ".toml", ".json", ".lua", ".service", ".desktop"}
SKIP_DIRS = {"target", ".git", "node_modules", "result", "vendor", "dist", "build"}
# Generated or about this inventory itself.
SKIP_FILES = {"omarchy-removal.md", "omarchy-inventory"}

CALL = re.compile(r"\bomarchy-([a-z0-9][a-z0-9-]*[a-z0-9])")
GATE = re.compile(
    r"omarchy::here\(\)|omarchy_available\(\)|ThemeMode::Omarchy|env\.omarchy|\"omarchy\":|"
    r"nyx_providers::omarchy|nyx_desktop::omarchy|nyx_theme::omarchy|crate::omarchy|mod omarchy|"
    r"Omarchy\s*=>|is_omarchy|on_omarchy"
)
PATHS = re.compile(r"\.config/omarchy|/usr/share/omarchy|\.local/share/omarchy|omarchy/current|omarchy/themes|omarchy/plugins")


def platform_jobs():
    """The jobs nyx-platform does, from nyx-core's crate (checkout or pinned)."""
    for base in sources().values():
        lib = base / "crates/nyx-platform/src/lib.rs"
        if lib.exists():
            text = lib.read_text()
            block = text.split("pub const JOBS", 1)[1].split("];", 1)[0]
            return set(re.findall(r'"([a-z0-9-]+)"', block))
    return set()


_sources = None


def sources():
    """repo name -> source folder."""
    global _sources
    if _sources is not None:
        return _sources
    found = {}
    pkgs = ARGS.projects / "nyx-packages"
    archive = json.loads(
        subprocess.run(["nix", "flake", "archive", "--json", f"path:{pkgs}"], capture_output=True, text=True, check=True).stdout
    )
    lock = json.loads((pkgs / "flake.lock").read_text())["nodes"]
    for name, node in archive.get("inputs", {}).items():
        repo = lock.get(name, {}).get("original", {}).get("repo", name)
        if repo.startswith("nyx") or repo in {"umbra-icons"}:
            found[repo] = Path(node["path"])
    for repo in ("nyxos", "nyx-packages", "nyx-system"):
        found.setdefault(repo, None)
    for repo in list(found):
        checkout = ARGS.projects / repo
        if (checkout / ".git").exists():
            found[repo] = checkout
    _sources = {k: v for k, v in found.items() if v and v.exists()}
    return _sources


def files(base: Path):
    for p in base.rglob("*"):
        if any(part in SKIP_DIRS for part in p.relative_to(base).parts[:-1]):
            continue
        if p.is_file() and p.suffix in CODE and p.name not in SKIP_FILES:
            yield p


def is_test(rel: str) -> bool:
    return "/tests/" in f"/{rel}" or rel.endswith("_test.rs") or "test_" in rel.rsplit("/", 1)[-1]


def scan():
    calls = defaultdict(list)  # command -> [(repo, rel, line)]
    gates, paths = [], []
    for repo, base in sorted(sources().items()):
        for p in files(base):
            rel = str(p.relative_to(base))
            try:
                lines = p.read_text(errors="replace").splitlines()
            except OSError:
                continue
            for n, line in enumerate(lines, 1):
                if "omarchy" not in line.lower():
                    continue
                where = (repo, rel, n, is_test(rel))
                for cmd in CALL.findall(line):
                    calls[cmd].append(where)
                if GATE.search(line):
                    gates.append(where + (line.strip()[:110],))
                if PATHS.search(line):
                    paths.append(where + (line.strip()[:110],))
    return calls, gates, paths


def write(calls, gates, paths):
    jobs = platform_jobs()
    per_repo = defaultdict(lambda: [0, set(), 0, 0])
    for cmd, sites in calls.items():
        for repo, *_ in sites:
            per_repo[repo][0] += 1
            per_repo[repo][1].add(cmd)
    for repo, *_ in gates:
        per_repo[repo][2] += 1
    for repo, *_ in paths:
        per_repo[repo][3] += 1
    covered = sorted(c for c in calls if c in jobs)
    out = [
        "# Omarchy removal: where the Nyx sources still depend on Omarchy",
        "",
        f"Generated {date.today()} by `scripts/omarchy-inventory` from {len(sources())} repositories "
        f"(checkouts in `{ARGS.projects}` where present, otherwise the revisions nyx-packages pins). "
        "Run it again after each cleanup; don't edit this file by hand.",
        "",
        "Omarchy/Arch support is being dropped. For each item: do the job natively (a `nyx-platform` "
        "job, or the app's own code), then delete the Omarchy branch. Don't keep two paths.",
        "",
        f"- **{len(calls)}** distinct `omarchy-*` commands, at **{sum(len(s) for s in calls.values())}** places; "
        f"`nyx-platform` already has a job for **{len(covered)}** of them",
        f"- **{len(gates)}** places that behave differently on Omarchy",
        f"- **{len(paths)}** references to Omarchy's files and folders",
        "",
        "## By repository",
        "",
        "| Repository | Command uses | Distinct commands | Omarchy gates | Omarchy paths |",
        "|---|---:|---:|---:|---:|",
    ]
    for repo, (uses, cmds, g, pth) in sorted(per_repo.items(), key=lambda kv: -(kv[1][0] + kv[1][2] + kv[1][3])):
        out.append(f"| {repo} | {uses} | {len(cmds)} | {g} | {pth} |")
    out += [
        "",
        "## Commands",
        "",
        "`job` means `nyx-platform` already does it, so the call can switch over now. "
        "Places in tests are marked *(test)*.",
        "",
        "| Command | nyx-platform | Uses | Where |",
        "|---|---|---:|---|",
    ]
    for cmd in sorted(calls, key=lambda c: (-len(calls[c]), c)):
        sites = calls[cmd]
        shown = ", ".join(
            f"{r}:`{f}:{n}`" + (" *(test)*" if t else "") for r, f, n, t in sites[:6]
        ) + (f", and {len(sites) - 6} more" if len(sites) > 6 else "")
        out.append(f"| `omarchy-{cmd}` | {'job' if cmd in jobs else ''} | {len(sites)} | {shown} |")
    for title, rows in (("Omarchy gates", gates), ("Omarchy paths", paths)):
        out += ["", f"## {title}", ""]
        current = None
        for repo, rel, n, test, text in rows:
            if repo != current:
                out += ["", f"### {repo}", ""]
                current = repo
            out.append(f"- `{rel}:{n}`{' *(test)*' if test else ''}: `{text.replace('`', '')}`")
    target = ROOT / "docs/omarchy-removal.md"
    target.write_text("\n".join(out) + "\n")
    print(f"{target}: {len(calls)} commands, {len(gates)} gates, {len(paths)} paths")


ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
ap.add_argument("--projects", type=Path, default=Path.home() / "Projects", help="where the checkouts are")
ARGS = ap.parse_args()
write(*scan())
