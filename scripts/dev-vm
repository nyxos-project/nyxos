#!/usr/bin/env bash
# Manage the NyxOS development VM on the local Incus host.
set -euo pipefail

vm=${NYXOS_VM:-nyxos-dev}
host=${NYXOS_HOST:-incus-dev}
image=${NYXOS_IMAGE:-images:nixos/26.05}
user=${NYXOS_USER:-ken}
# Host GPU shared with the VM through virtio-gpu DRM native context (the Intel iGPU here).
gpu_pci=${NYXOS_GPU_PCI:-0000:00:02.0}
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
flake_dir=/etc/nyxos/flake
# A local nyx-packages checkout. Set NYX_PACKAGES to build NyxOS against it instead of
# the revision pinned in flake.lock.
packages_repo=${NYX_PACKAGES:-}
packages_dir=/etc/nyxos/nyx-packages
# Local checkouts of nyx-packages' sources, used with NYX_PACKAGES: NYX_SOURCES is
# "INPUT=PATH ..." (nyx-welcome=~/Projects/nyx-welcome); NYX_SYSTEM is nyx-system's.
sources=${NYX_SOURCES:-}
[[ -n ${NYX_SYSTEM:-} ]] && sources+=" nyx-system=$NYX_SYSTEM"
vm_path=/run/wrappers/bin:/run/current-system/sw/bin

usage() {
  cat <<EOF
Usage: scripts/dev-vm <command> [args]

  create              Launch $vm from $image (6 vCPU, 8 GiB, 50 GiB disk, GPU $gpu_pci)
  gpu [on|off]        Add or remove the accelerated GPU (stops the VM briefly)
  sync                Copy this checkout to $flake_dir in the VM
  rebuild [action]    sync, then nixos-rebuild <action> (default: switch)
  packages <args...>  Copy \$NYX_PACKAGES (default ../nyx-packages) to the VM and
                      run nix <args> there, e.g. "packages build .#nyx-fonts"
  rollback            Switch back to the previous system generation
  generations         List system generations
  check               sync, then nix flake check in the VM
  ip                  Print the VM's IPv4 address
  ssh [args]          SSH in as $user
  exec <cmd...>       Run a command as root in the VM
  shot [file]         Screenshot the VM's Hyprland session (default: shot.png)
  disk [check|clean]  How much of the disk quota the host counts (after a trim); clean
                      drops old generations, garbage and all but 3 known-good snapshots
  snapshot <name>     Create an Incus snapshot
  restore <name>      Restore an Incus snapshot
  destroy             Delete the VM and its snapshots
EOF
}

vm_exec() {
  incus exec "$vm" --env PATH="$vm_path" -- "$@"
}

wait_for_agent() {
  for _ in $(seq 120); do
    vm_exec true 2>/dev/null && return
    sleep 1
  done
  echo "Incus agent in $vm didn't come up" >&2
  return 1
}

vm_ip() {
  incus list "$vm" -c4 -f csv | grep -oE '^[0-9.]+' | head -1
}

push_tree() {
  vm_exec rm -rf "$2"
  vm_exec mkdir -p "$2"
  tar -C "$1" --exclude=.git --exclude='result*' --exclude=./target -cf - . | vm_exec tar -C "$2" -xf -
}

# Copies lock files Nix wrote in the VM back to the checkout they belong to.
pull_lock() {
  if vm_exec test -f "$1/flake.lock"; then
    incus file pull "$vm$1/flake.lock" "$2/flake.lock"
  fi
}

override_args=()

sync() {
  push_tree "$repo" "$flake_dir"
  if [[ -n $packages_repo ]]; then
    push_tree "$packages_repo" "$packages_dir"
    override_args=(--override-input nyx-packages "path:$packages_dir")
    for source in $sources; do
      push_tree "${source#*=}" "/etc/nyxos/${source%%=*}"
      override_args+=(--override-input "nyx-packages/${source%%=*}" "path:/etc/nyxos/${source%%=*}")
    done
  fi
  # What the Nyx System Manager set on the VM (its overrides layer) stays set.
  if vm_exec test -d /etc/nyxos/overrides; then
    override_args+=(--override-input nyxos-overrides path:/etc/nyxos/overrides)
  fi
}

rebuild() {
  sync
  vm_exec nixos-rebuild "${1:-switch}" --flake "path:$flake_dir#$host" "${override_args[@]}"
  # An overridden input must not end up in flake.lock.
  [[ -n $packages_repo ]] || pull_lock "$flake_dir" "$repo"
  disk_check
}

# The VM's disk is a file in a Btrfs pool with a quota: every block written counts until
# the guest trims it, and past the quota the guest's disk turns read-only. So: trim, and
# warn while there's still room to act.
gib() { awk '{ v = $1; u = $2; if (u ~ /^T/) v *= 1024; else if (u ~ /^M/) v /= 1024; printf "%d", v }'; }
disk_check() {
  vm_exec fstrim / >/dev/null 2>&1 || true
  local used quota
  used=$(incus info "$vm" | awk '/Disk usage:/ { getline; sub(/GiB|TiB|MiB/, " &", $2); print $2, $3 }' | gib)
  quota=$(incus config device get "$vm" root size | sed 's/GiB//')
  echo "disk: ${used} GiB of ${quota} GiB counted on the host"
  if ((used * 100 > quota * 75)); then
    echo "WARNING: the VM's disk is over 75% of its quota. Run: scripts/dev-vm disk clean" >&2
  fi
}

# Old generations, the store's garbage and old known-good snapshots (the newest three stay).
disk_clean() {
  vm_exec nix-env --delete-generations +3 --profile /nix/var/nix/profiles/system >/dev/null
  vm_exec nix-collect-garbage | tail -1
  vm_exec journalctl --vacuum-size=200M >/dev/null 2>&1 || true
  incus snapshot list "$vm" -f csv -c n | grep '^known-good-' | sort -t- -k3 -n | head -n -3 |
    while read -r s; do incus snapshot delete "$vm" "$s" && echo "deleted snapshot $s"; done
  disk_check
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift

case $cmd in
  create)
    incus init "$image" "$vm" --vm \
      -c limits.cpu=6 -c limits.memory=8GiB -c security.secureboot=false \
      -d root,size=50GiB
    incus config device add "$vm" gpu gpu gputype=native-context pci="$gpu_pci"
    incus start "$vm"
    wait_for_agent
    ;;
  gpu)
    incus stop "$vm"
    case ${1:-on} in
      on) incus config device add "$vm" gpu gpu gputype=native-context pci="$gpu_pci" ;;
      off) incus config device remove "$vm" gpu ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
    incus start "$vm"
    wait_for_agent
    ;;
  sync) sync ;;
  rebuild) rebuild "$@" ;;
  # Without --flake, nixos-rebuild tries to rebuild itself from <nixpkgs/nixos> and fails.
  rollback) vm_exec nixos-rebuild switch --rollback --flake "path:$flake_dir#$host" ;;
  generations) vm_exec nixos-rebuild list-generations ;;
  check)
    sync
    vm_exec nix flake check "path:$flake_dir" "${override_args[@]}"
    ;;
  packages)
    src=${packages_repo:-$repo/../nyx-packages}
    src=$(cd "$src" && pwd)
    push_tree "$src" "$packages_dir"
    vm_exec bash -c 'cd "$1" && shift && nix "$@"' _ "$packages_dir" "$@"
    pull_lock "$packages_dir" "$src"
    ;;
  ip) vm_ip ;;
  ssh) exec ssh "$user@$(vm_ip)" "$@" ;;
  exec) vm_exec "$@" ;;
  shot)
    out=${1:-shot.png}
    uid=$(vm_exec id -u "$user")
    # A failed capture mustn't leave the last one to be copied instead.
    vm_exec rm -f /tmp/nyxos-shot.png
    # Hyprland can't see which program a process `incus exec --user` started is, so its
    # screencopy rules never allow it; runuser's processes it can.
    vm_exec runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" WAYLAND_DISPLAY=wayland-1 \
      grim /tmp/nyxos-shot.png
    incus file pull "$vm/tmp/nyxos-shot.png" "$out"
    echo "$out"
    ;;
  snapshot)
    # Snapshots of a running VM are crash-consistent; flush the guest's writes first.
    # Trim first too: a snapshot keeps every block it holds for as long as it exists.
    vm_exec sync
    vm_exec fstrim / >/dev/null 2>&1 || true
    incus snapshot create "$vm" "${1:?snapshot name}"
    ;;
  disk)
    case ${1:-check} in
      check) disk_check ;;
      clean) disk_clean ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
    ;;
  restore) incus snapshot restore "$vm" "${1:?snapshot name}" ;;
  destroy) incus delete --force "$vm" ;;
  "" | -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
